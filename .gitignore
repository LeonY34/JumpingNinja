# Jumping Ninja repository ignore rules
# Keep source, Unity .meta files, server migrations, tests, and documentation tracked.

# Unity-generated caches and build output
/.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/ExportedObj/
*.log
mono_crash.*
sysinfo.txt

# Unity-generated IDE files at the project root
/*.csproj
/*.unityproj
/*.sln
/*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.DotSettings.user
*.pidb.meta
*.pdb.meta
*.mdb.meta

# IDE and local tool state
/.vs/
/.vscode/
/.idea/
/.gradle/
/.consulo/
*.tmp

# Local AI codebase memory
/docs/ai/INDEX.md

# .NET build and test output (server project files remain trackable)
**/[Bb]in/
**/[Oo]bj/
**/[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml
/coverage/
/.coverage/

# Local environment files, credentials, and signing material
**/.env
**/.env.*
!**/.env.example
*.pfx
*.p12
*.key
*.pem
appsettings.*.local.json
secrets.json

# Packaged application output
*.apk
*.aab
*.app
*.unitypackage
*.unitypackage.meta
crashlytics-build.properties

# Unity generated/import-only files
*.blend1
*.blend1.meta
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*
/[Aa]ssets/[Ss]ceneDependencyCache*
/ServerData/
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# Operating-system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini
